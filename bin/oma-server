#!/usr/bin/env -S bash -p
# bash -p: privileged mode never imports exported functions (BASH_FUNC_*%%), BASH_ENV,
# ENV or SHELLOPTS from the caller, so nothing can shadow sudo/type/realpath here.
# Re-exec under bash -p when started as `bash file` (omarchy-hook runs hooks that way),
# so exported functions/SHELLOPTS from the caller are dropped here as well. Skipped
# when sourced (BASH_SOURCE != $0), so it never replaces the caller's shell.
[[ "${BASH_SOURCE[0]}" != "$0" || $- == *p* ]] || exec /usr/bin/env -S bash -p -- "$0" "$@"
# ~/.config/omarchy/plugins/server-mode/bin/omarchy-server-mode
# Enterprise CLI coordinator for oma-server (Omarchy Server-Mode)
set -euo pipefail

readonly OMA_SERVER_VERSION="1.2.0"

# omarchy-shell / omarchy-plugin-catalog need OMARCHY_PATH; it is only set inside
# the graphical session, so default it for plain SSH / non-login shells.
: "${OMARCHY_PATH:=/usr/share/omarchy}"
export OMARCHY_PATH

# 1. Startup Pre-Flight Dependency Audit
for dep in jq hyprctl flock date pgrep awk sed tr; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        printf "[ FAIL ] Required system dependency '%s' was not found in PATH.\n" "$dep" >&2
        exit 1
    fi
done

# 2. Directory and Module Path Resolution
CMD_NAME="$(basename "$0")"
REAL_SCRIPT="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$REAL_SCRIPT")" &>/dev/null && pwd)"
PLUGIN_ROOT="$(cd -- "$SCRIPT_DIR/.." &>/dev/null && pwd)"
USER_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/server-mode/config.toml"
CONFIG_FILE="$USER_CONFIG_FILE"
if [[ ! -f "$CONFIG_FILE" && -f "$PLUGIN_ROOT/config/config.toml" ]]; then
    CONFIG_FILE="$PLUGIN_ROOT/config/config.toml"
fi
LIB_DIR="$PLUGIN_ROOT/lib"

for lib_mod in ui.sh config.sh snapshot.sh transition.sh deep.sh; do
    if [[ ! -f "$LIB_DIR/$lib_mod" ]]; then
        printf "[ FAIL ] Required library '%s/%s' not found.\n" "$LIB_DIR" "$lib_mod" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$LIB_DIR/$lib_mod"
done

# 3. Validate User & Session Scoping (Strictly inside ephemeral /run/user/${UID})
validate_runtime_environment

CURRENT_UID="${UID:-$(id -u)}"
RUN_DIR="${OMA_SERVER_RUN_DIR:-/run/user/${CURRENT_UID}/omarchy-server-mode}"
SNAPSHOT_FILE="$RUN_DIR/active-snapshot.json"
LOCK_FILE="$RUN_DIR/lock"

# A reboot while in Deep Server Mode already brought the desktop back: clear stale deep state.
deep_reconcile_boot || true

# Deep Server Mode status (DEEP_ENTERING / DEEP_SERVER / DEEP_EXITING / DEEP_DEGRADED)
# [profile] quickshell_strategy: only "sigstop" is implemented (lib/snapshot.sh and
# lib/transition.sh always pause the shell with SIGSTOP). Say so instead of silently
# ignoring another value.
resolve_quickshell_strategy() {
    local s
    s="$(config_get_scalar "$CONFIG_FILE" "profile" "quickshell_strategy" "sigstop")"
    if [[ "${s,,}" != "sigstop" ]]; then
        ui_log_warn "[profile] quickshell_strategy = \"${s}\" is not supported; using \"sigstop\" (the only implemented strategy)." >&2
    fi
    printf "sigstop"
}

deep_status() {
    local as_json="$1"
    local state entered now elapsed tlabel tepoch timeout_status="Disabled (no --timeout)" health="OK"
    state=$(deep_state_get state "DEEP_SERVER")
    entered=$(deep_state_get entered_at "0")
    [[ "$entered" =~ ^[0-9]+$ ]] || entered=0
    now=$(date +%s)
    elapsed=$(( now - entered )); (( elapsed < 0 )) && elapsed=0
    tlabel=$(deep_state_get timeout_label "")
    tepoch=$(deep_state_get timeout_epoch "")
    if [[ "$tepoch" =~ ^[0-9]+$ ]]; then
        if (( tepoch > now )); then
            timeout_status="Active (${tlabel}, $(ui_format_duration_human $(( tepoch - now ))) left)"
        else
            timeout_status="Expired (${tlabel})"
        fi
    fi
    local hint=""
    if [[ "$state" == "DEEP_DEGRADED" ]]; then
        health="DEGRADED"
    elif [[ "$state" == "DEEP_EXITING" || "$state" == "DEEP_ENTERING" ]] && ! deep_lock_held; then
        # A transition state with nobody holding deep.lock: its worker died.
        health="DEGRADED"
        hint="stale ${state} (no transition running); run 'oma-server disable' to finish"
    fi
    local since; since=$(date -d "@$entered" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "epoch:$entered")
    if [[ "$as_json" == "true" ]]; then
        jq -n --arg mode "$state" --arg since "$since" --argjson el "$elapsed" \
            --arg eh "$(ui_format_duration_human "$elapsed")" --arg ts "$timeout_status" --arg health "$health" \
            --arg rt "$DEEP_STATE_FILE" --arg hint "$hint" '{
                mode: $mode, is_homelab: false, is_deep: true, since: $since,
                elapsed_seconds: $el, elapsed_human: $eh,
                inhibitor: "Active (root, oma-server-deep-inhibit)", timeout: null,
                timeout_status: $ts, timeout_remaining: "", dpms: "N/A (no session)",
                quickshell: "Stopped (Deep Server)", protected_active: 0, protected_total: 0,
                health: $health, runtime_state: $rt, health_hint: $hint
            }'
        return 0
    fi
    echo ""
    ui_log_info "Mode        : ${state}"
    ui_log_info "Since       : ${since} ($(ui_format_duration_human "$elapsed"))"
    ui_log_info "Auto-revert : ${timeout_status}"
    ui_log_info "State file  : ${DEEP_STATE_FILE}"
    if [[ -n "$hint" ]]; then
        ui_log_warn "Health      : DEGRADED, ${hint}." "Or '${DEEP_PANIC_HINT}'."
    elif [[ "$health" == "DEGRADED" ]]; then
        ui_log_warn "The last exit did not bring the desktop back." "Run '$CMD_NAME disable' again, or '${DEEP_PANIC_HINT}'."
    else
        ui_log_info "Way back    : '$CMD_NAME disable' (SSH or Ctrl+Alt+F2), reboot, or '${DEEP_PANIC_HINT}'"
    fi
}

# 4. Helper: Gather Live Telemetry for Status & JSON Output
collect_status_telemetry() {
    local as_json="$1"

    local dpms_live="ON (Active)"
    local monitors_json=""
    if monitors_json=$(run_with_timeout 5 hyprctl -j monitors 2>/dev/null) && [[ -n "$monitors_json" ]]; then
        local any_dpms
        any_dpms=$(printf "%s" "$monitors_json" | jq -r 'if (type == "array" and length > 0) then any(.[]; .dpmsStatus == true) else true end' 2>/dev/null || echo "true")
        if [[ "$any_dpms" == "false" ]]; then
            dpms_live="OFF (Power Saving)"
        fi
    fi

    local qs_live
    qs_live="$(get_quickshell_telemetry)"

    local -a whitelist_units=()
    mapfile -t whitelist_units < <(get_whitelist_services "$CONFIG_FILE")
    local total_units="${#whitelist_units[@]}"
    local active_units=0
    local unit
    for unit in "${whitelist_units[@]}"; do
        [[ -z "$unit" ]] && continue
        if run_with_timeout 1 systemctl is-active --quiet "$unit" 2>/dev/null || \
           run_with_timeout 1 systemctl --user is-active --quiet "$unit" 2>/dev/null; then
            active_units=$(( active_units + 1 ))
        fi
    done
    local protected_summary="${active_units}/${total_units} active (Protected)"

    if [[ -f "$SNAPSHOT_FILE" ]] && validate_snapshot "$SNAPSHOT_FILE" >/dev/null 2>&1; then
        local ts now_epoch elapsed_sec elapsed_human date_str
        ts=$(jq -r '.timestamp' "$SNAPSHOT_FILE" 2>/dev/null || echo "0")
        now_epoch=$(date +%s)
        elapsed_sec=$(( now_epoch - ts ))
        (( elapsed_sec < 0 )) && elapsed_sec=0
        elapsed_human="$(ui_format_duration_human "$elapsed_sec")"
        date_str=$(date -d "@$ts" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "epoch:$ts")

        local in_status="Inactive"
        local health="OK"
        if [[ -f "$RUN_DIR/inhibitor.pid" ]]; then
            local in_pid
            in_pid=$(tr -d '[:space:]' < "$RUN_DIR/inhibitor.pid" 2>/dev/null || true)
            if verify_pid_identity "$in_pid" "systemd-inhibit|sleep"; then
                in_status="Active (PID: $in_pid)"
            elif systemctl --user is-active --quiet oma-server-inhibitor.service 2>/dev/null; then
                in_status="Active (systemd)"
            else
                in_status="Stale"
                health="DEGRADED"
            fi
        elif systemctl --user is-active --quiet oma-server-inhibitor.service 2>/dev/null; then
            in_status="Active (systemd)"
        else
            in_status="Inactive"
            health="DEGRADED"
        fi

        local timeout_pid=""
        local timeout_status="Disabled (Manual Mode)"
        local timeout_remaining=""
        if [[ -f "$RUN_DIR/timeout.pid" ]]; then
            timeout_pid=$(tr -d '[:space:]' < "$RUN_DIR/timeout.pid" 2>/dev/null || true)
            if verify_pid_identity "$timeout_pid" "oma-server|omarchy-server|bash|sleep"; then
                if [[ -f "$RUN_DIR/timeout.meta" ]]; then
                    local t_label t_exp rem_sec
                    IFS='|' read -r t_label t_exp < "$RUN_DIR/timeout.meta" || true
                    if [[ "${t_exp:-0}" =~ ^[0-9]+$ ]] && (( t_exp > now_epoch )); then
                        rem_sec=$(( t_exp - now_epoch ))
                        timeout_remaining="$(ui_format_duration_human "$rem_sec")"
                        timeout_status="Active (${t_label}, ${timeout_remaining} left)"
                    else
                        timeout_status="Active (PID: $timeout_pid)"
                    fi
                else
                    timeout_status="Active (PID: $timeout_pid)"
                fi
            else
                timeout_pid=""
            fi
        fi

        if [[ "$as_json" == "true" ]]; then
            jq -n \
              --arg mode "HOMELAB_MODE" \
              --argjson is_homelab true \
              --arg since "$date_str" \
              --argjson elapsed_seconds "$elapsed_sec" \
              --arg elapsed_human "$elapsed_human" \
              --arg inhibitor "$in_status" \
              --arg timeout "${timeout_pid:-null}" \
              --arg timeout_status "$timeout_status" \
              --arg timeout_remaining "${timeout_remaining:-}" \
              --arg dpms "$dpms_live" \
              --arg quickshell "$qs_live" \
              --argjson protected_active "$active_units" \
              --argjson protected_total "$total_units" \
              --arg health "$health" \
              --arg runtime "$RUN_DIR" \
              '{
                mode: $mode,
                is_homelab: $is_homelab,
                since: $since,
                elapsed_seconds: $elapsed_seconds,
                elapsed_human: $elapsed_human,
                inhibitor: $inhibitor,
                timeout: (if $timeout == "null" or $timeout == "" then null else $timeout end),
                timeout_status: $timeout_status,
                timeout_remaining: $timeout_remaining,
                dpms: $dpms,
                quickshell: $quickshell,
                protected_active: $protected_active,
                protected_total: $protected_total,
                health: $health,
                runtime_state: $runtime
              }'
            return 0
        fi

        ui_render_status_panel \
            "HOMELAB_MODE" \
            "true" \
            "$date_str" \
            "$elapsed_human" \
            "$in_status" \
            "$timeout_status" \
            "$dpms_live" \
            "$qs_live" \
            "$RUN_DIR" \
            "$protected_summary" \
            "$health"

        if [[ "$health" == "DEGRADED" ]]; then
            echo ""
            ui_log_warn "Inhibitor process is stale or missing while Homelab snapshot is active." \
                "Run '$CMD_NAME rescue' or '$CMD_NAME disable' to resynchronize system state."
        fi
        return 0
    fi

    if [[ "$as_json" == "true" ]]; then
        jq -n \
          --arg mode "HOST_LAPTOP" \
          --argjson is_homelab false \
          --arg inhibitor "Inactive" \
          --arg timeout_status "Standby" \
          --arg dpms "$dpms_live" \
          --arg quickshell "$qs_live" \
          --argjson protected_active "$active_units" \
          --argjson protected_total "$total_units" \
          --arg health "OK" \
          '{
            mode: $mode,
            is_homelab: $is_homelab,
            since: null,
            elapsed_seconds: 0,
            elapsed_human: "00h 00m 00s",
            inhibitor: $inhibitor,
            timeout: null,
            timeout_status: $timeout_status,
            timeout_remaining: "",
            dpms: $dpms,
            quickshell: $quickshell,
            protected_active: $protected_active,
            protected_total: $protected_total,
            health: $health,
            runtime_state: null
          }'
        return 0
    fi

    ui_render_status_panel \
        "HOST_LAPTOP" \
        "false" \
        "N/A (Desktop Profile Active)" \
        "00h 00m 00s" \
        "Inactive (Standard Power Policy)" \
        "Inactive" \
        "$dpms_live" \
        "$qs_live" \
        "None (Clean)" \
        "$protected_summary" \
        "OK"
}

print_usage() {
    local w=76
    printf "\n%s┌%s┐%s\n" "${UI_CYAN}" "$(ui_hr "$w")" "${UI_RESET}"
    ui_box_line "$w" "  ${UI_BOLD}${UI_WHITE}OMA-SERVER v${OMA_SERVER_VERSION} // PERFORMANCE & HOMELAB MODE ORCHESTRATOR${UI_RESET}"
    printf "%s├%s┤%s\n" "${UI_CYAN}" "$(ui_hr "$w")" "${UI_RESET}"
    ui_box_line "$w" "  ${UI_BOLD}USAGE:${UI_RESET}   ${CMD_NAME} <command> [options]"
    printf "%s├%s┤%s\n" "${UI_CYAN}" "$(ui_hr "$w")" "${UI_RESET}"
    ui_box_line "$w" "  ${UI_BOLD}${UI_MUTED}COMMANDS:${UI_RESET}"
    ui_box_line "$w" "$(printf "    %-24s %s" "status [--json]" "Display live telemetry panel or JSON payload")"
    ui_box_line "$w" "$(printf "    %-24s %s" "diff" "Render in-memory transition plan & Tier-0 audit")"
    ui_box_line "$w" "$(printf "    %-24s %s" "enable [options]" "Transition from HOST_LAPTOP to HOMELAB_MODE")"
    ui_box_line "$w" "$(printf "    %-24s %s" "disable" "Restore full desktop session & release locks")"
    ui_box_line "$w" "$(printf "    %-24s %s" "rescue" "Force emergency recovery to safe baseline")"
    ui_box_line "$w" "$(printf "    %-24s %s" "deep-setup [--remove]" "Opt-in: install/remove Deep Server root helper")"
    ui_box_line "$w" "$(printf "    %-24s %s" "diff --deep" "Show the Deep Server plan (windows, units)")"
    ui_box_line "$w" "$(printf "    %-24s %s" "deep-shell [name]" "Deep console: none|tmux|btop|tuios|zellij|custom")"
    printf "%s├%s┤%s\n" "${UI_CYAN}" "$(ui_hr "$w")" "${UI_RESET}"
    ui_box_line "$w" "  ${UI_BOLD}${UI_MUTED}ENABLE OPTIONS:${UI_RESET}"
    ui_box_line "$w" "$(printf "    %-24s %s" "--dry-run" "Simulate transition in memory without changes")"
    ui_box_line "$w" "$(printf "    %-24s %s" "-y, --yes" "Skip interactive confirmation prompt")"
    ui_box_line "$w" "$(printf "    %-24s %s" "--timeout <duration>" "Auto-revert Dead Man's Switch (e.g. 45m, 2h)")"
    ui_box_line "$w" "$(printf "    %-24s %s" "--deep" "DEEP_SERVER: stop desktop + greeter (no -y)")"
    ui_box_line "$w" "$(printf "    %-24s %s" "--close-apps" "With --deep: close open windows (type 'yes')")"
    printf "%s└%s┘%s\n" "${UI_CYAN}" "$(ui_hr "$w")" "${UI_RESET}"
}

# 5. CLI Command Dispatcher
cmd="${1:-}"

case "$cmd" in
    status)
        shift || true
        as_json="false"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json)
                    as_json="true"
                    shift
                    ;;
                *)
                    ui_log_fail "Unknown option '$1' for 'status' command." "Supported flag: --json"
                    exit 1
                    ;;
            esac
        done
        deep_allowed="$(config_get_bool "$CONFIG_FILE" "deep" "allowed" "false")"
        last_deep="null"
        if [[ -f "$DEEP_LAST_FILE" ]] && jq -e 'type == "object"' "$DEEP_LAST_FILE" >/dev/null 2>&1; then
            last_deep="$(jq -c . "$DEEP_LAST_FILE")"
        fi
        # N4: deep is allowed in config but the root helper is gone (e.g. an orphaned
        # grant): enable --deep would refuse, so say so instead of reporting OK.
        deep_helper_ok="true"
        deep_helper_hint=""
        if [[ "$deep_allowed" == "true" ]] && ! deep_helper_installed; then
            deep_helper_ok="false"
            deep_helper_hint="deep helper missing; run '$CMD_NAME deep-setup' or '$CMD_NAME deep-setup --remove'"
        fi
        if [[ "$as_json" == "true" ]]; then
            if deep_state_exists; then
                status_json="$(deep_status true)"
            else
                status_json="$(collect_status_telemetry true)"
            fi
            printf "%s" "$status_json" | jq --argjson allowed "$deep_allowed" --argjson last "$last_deep" \
                --argjson hok "$deep_helper_ok" --arg hhint "$deep_helper_hint" \
                '. + {is_deep: (.is_deep // false), deep_allowed: $allowed, last_deep: $last, deep_helper_ok: $hok}
                 | if $hok then . else .health = "DEGRADED"
                     | .health_hint = ([(.health_hint // ""), $hhint] | map(select(length > 0)) | join("; ")) end'
            exit 0
        fi
        if deep_state_exists; then
            deep_status false
        else
            collect_status_telemetry false
        fi
        if [[ "$deep_helper_ok" != "true" ]]; then
            ui_log_warn "Health      : DEGRADED, ${deep_helper_hint}." \
                "[deep] allowed = true, but $DEEP_HELPER_PATH is missing or unsafe, so 'enable --deep' refuses."
        fi
        exit 0
        ;;

    diff)
        shift || true
        if [[ "${1:-}" == "--deep" && $# -eq 1 ]]; then
            deep_render_plan "$CONFIG_FILE"
            exit 0
        fi
        if [[ $# -gt 0 ]]; then
            ui_log_fail "Unexpected argument '$1' for 'diff' command." "Run '$CMD_NAME diff' with no arguments."
            exit 1
        fi
        qs_strategy="$(resolve_quickshell_strategy)"
        snapshot_in_memory="$(capture_snapshot "$qs_strategy")"
        mapfile -t services < <(get_whitelist_services "$CONFIG_FILE")
        ui_render_diff_panel "$snapshot_in_memory" "" "${services[@]}"
        exit 0
        ;;

    enable)
        is_dry_run="false"
        skip_confirm="false"
        timeout_arg=""
        deep_mode="false"
        close_apps="false"
        shift || true

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --dry-run)
                    is_dry_run="true"
                    shift
                    ;;
                -y|--yes)
                    skip_confirm="true"
                    shift
                    ;;
                --deep)
                    deep_mode="true"
                    shift
                    ;;
                --close-apps)
                    close_apps="true"
                    shift
                    ;;
                --timeout)
                    if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
                        ui_log_fail "Missing duration value for '--timeout' flag." \
                            "Provide a duration such as '--timeout 30m' or '--timeout 2h'."
                        exit 1
                    fi
                    timeout_arg="$2"
                    shift 2
                    ;;
                --timeout=*)
                    timeout_arg="${1#--timeout=}"
                    if [[ -z "$timeout_arg" ]]; then
                        ui_log_fail "Empty duration value in '$1'." \
                            "Provide a duration such as '--timeout=30m' or '--timeout=2h'."
                        exit 1
                    fi
                    shift
                    ;;
                *)
                    ui_log_fail "Unknown option '$1' for 'enable' command." \
                        "Valid options: --dry-run, -y, --yes, --timeout <duration>, --deep, --close-apps."
                    exit 1
                    ;;
            esac
        done

        if [[ "$close_apps" == "true" && "$deep_mode" != "true" ]]; then
            ui_log_fail "'--close-apps' is only valid with '--deep'."
            exit 1
        fi

        if deep_state_exists; then
            ui_log_fail "Deep Server Mode state is active ($(deep_state_get state UNKNOWN))." "Run '$CMD_NAME disable' first."
            exit 1
        fi

        if [[ "$deep_mode" == "true" ]]; then
            if [[ "$skip_confirm" == "true" ]]; then
                ui_log_fail "'-y/--yes' is not accepted with '--deep'." \
                    "Deep Server Mode has no confirmation bypass; open windows need --close-apps and a typed 'yes'."
                exit 2
            fi
            if [[ "$is_dry_run" == "true" ]]; then
                deep_render_plan "$CONFIG_FILE"
                exit 0
            fi
            # Deep mode never uses [profile] default_timeout: a timer exists only with --timeout.
            deep_timeout_seconds="$(parse_and_validate_timeout "${timeout_arg:-0}")"
            deep_rc=0
            deep_enter_transaction "$CONFIG_FILE" "$close_apps" "$deep_timeout_seconds" "${timeout_arg:-}" "$REAL_SCRIPT" || deep_rc=$?
            exit "$deep_rc"
        fi

        # Fallback to config default_timeout if not supplied on CLI
        if [[ -z "$timeout_arg" ]]; then
            timeout_arg="$(config_get_scalar "$CONFIG_FILE" "profile" "default_timeout" "0")"
        fi

        # Validate timeout schema before any state inspection or mutation
        timeout_seconds="$(parse_and_validate_timeout "$timeout_arg")"

        # Check if already in HOMELAB_MODE
        if [[ -f "$SNAPSHOT_FILE" ]] && validate_snapshot "$SNAPSHOT_FILE" >/dev/null 2>&1; then
            ui_log_info "System is already operating in HOMELAB_MODE."
            printf "         %s└─ Tip:%s Run '%s disable' to restore HOST_LAPTOP profile.\n" "${UI_MUTED}" "${UI_RESET}" "$CMD_NAME"
            exit 0
        fi

        qs_strategy="$(resolve_quickshell_strategy)"
        snapshot_in_memory="$(capture_snapshot "$qs_strategy")"
        mapfile -t services < <(get_whitelist_services "$CONFIG_FILE")

        if [[ "$is_dry_run" == "true" ]]; then
            ui_render_diff_panel "$snapshot_in_memory" "$timeout_arg" "${services[@]}"
            echo ""
            ui_log_ok "Dry-run simulation complete. Zero system mutations were applied."
            exit 0
        fi

        if [[ "$skip_confirm" == "false" ]]; then
            if [[ ! -t 0 ]]; then
                ui_log_fail "Interactive confirmation required, but standard input is not a TTY." \
                    "Pass '-y' or '--yes' for non-interactive execution."
                exit 1
            fi
            ui_render_diff_panel "$snapshot_in_memory" "$timeout_arg" "${services[@]}"
            echo ""
            printf "%s Confirm transition from HOST_LAPTOP to HOMELAB_MODE? [y/N]: " "$(ui_badge_info)"
            read -r confirm || confirm="n"
            if [[ "${confirm,,}" != "y" && "${confirm,,}" != "yes" ]]; then
                ui_log_info "Transition cancelled by user. System remains in HOST_LAPTOP mode."
                exit 0
            fi
        fi

        op_start_ms="$(ui_now_ms)"
        ensure_secure_run_dir "$RUN_DIR"

        # Acquire exclusive non-blocking transaction lock
        exec 200>"$LOCK_FILE"
        if ! flock -n 200; then
            ui_log_fail "Another oma-server operation holds the transaction lock at '$LOCK_FILE'." \
                "Wait for the active transition to complete or run '$CMD_NAME rescue'."
            exit 1
        fi

        if ! write_snapshot_atomic "$snapshot_in_memory" "$SNAPSHOT_FILE"; then
            ui_log_fail "Atomic snapshot write/validation failed at '$SNAPSHOT_FILE'." \
                "Verify free space in '$RUN_DIR' (tmpfs)."
            rm -f "$LOCK_FILE"
            rmdir "$RUN_DIR" 2>/dev/null || true
            exit 1
        fi

        if ! apply_homelab_mode "$RUN_DIR" "$CONFIG_FILE" "$SNAPSHOT_FILE" "$timeout_seconds" "$timeout_arg" "$REAL_SCRIPT"; then
            rm -f "$LOCK_FILE"
            # Failed-enable rollback leaves an empty runtime dir behind; drop it.
            rmdir "$RUN_DIR" 2>/dev/null || true
            exit 1
        fi

        # Release transaction lock FD cleanly now that state transition is complete
        exec 200>&- || true

        op_elapsed="$(ui_format_elapsed_ms "$op_start_ms")"
        echo ""
        ui_log_ok "System transitioned to HOMELAB_MODE in ${op_elapsed}."
        printf "       %s└─ Wake / Restore:%s Run '%s disable' or move mouse/keyboard to wake display.\n" \
            "${UI_MUTED}" "${UI_RESET}" "$CMD_NAME"
        exit 0
        ;;

    disable)
        shift || true
        is_auto_timeout="false"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --auto-timeout)
                    is_auto_timeout="true"
                    shift
                    ;;
                *)
                    ui_log_fail "Unknown option '$1' for 'disable' command." "Run '$CMD_NAME disable'."
                    exit 1
                    ;;
            esac
        done

        if deep_state_exists; then
            deep_rc=0
            deep_from="$(deep_state_get state DEEP_SERVER)"
            deep_exit_transaction "$CONFIG_FILE" "$is_auto_timeout" || deep_rc=$?
            if (( deep_rc == 0 )); then
                ui_log_ok "Desktop restored: ${deep_from} -> HOST_LAPTOP."
            fi
            exit "$deep_rc"
        fi

        if [[ ! -f "$SNAPSHOT_FILE" ]]; then
            ui_log_info "System is already operating in HOST_LAPTOP mode (no active snapshot)."
            exit 0
        fi

        op_start_ms="$(ui_now_ms)"
        ensure_secure_run_dir "$RUN_DIR"

        exec 200>"$LOCK_FILE"
        if ! flock -w 5 200; then
            ui_log_warn "Transaction lock contention detected; proceeding with forced restoration."
        fi

        if [[ "$is_auto_timeout" == "true" ]]; then
            ui_log_warn "Dead Man's Switch timer expired. Auto-restoring HOST_LAPTOP profile..."
        fi

        restore_rc=0
        restore_host_mode "$RUN_DIR" "$SNAPSHOT_FILE" "$is_auto_timeout" || restore_rc=$?

        { exec 200>&-; } 2>/dev/null || true
        rm -f "$LOCK_FILE"

        op_elapsed="$(ui_format_elapsed_ms "$op_start_ms")"
        echo ""
        if (( restore_rc != 0 )); then
            ui_log_fail "Desktop restore FAILED after ${op_elapsed}; HOMELAB_MODE state was kept." \
                "Run '$CMD_NAME disable' again once Hyprland responds, or '$CMD_NAME rescue' to force a baseline."
            exit 1
        fi
        # Leave no empty state directory behind in HOST_LAPTOP mode (only removed if empty).
        rmdir "$RUN_DIR" 2>/dev/null || true
        ui_log_ok "Desktop restored to HOST_LAPTOP mode in ${op_elapsed}."
        exit 0
        ;;

    rescue)
        shift || true
        op_start_ms="$(ui_now_ms)"
        if deep_state_exists; then
            deep_exit_transaction "$CONFIG_FILE" "false" || \
                ui_log_warn "Deep Server exit did not complete." "Panic: ${DEEP_PANIC_HINT}"
        fi
        force_rescue_mode "$RUN_DIR" "$SNAPSHOT_FILE"
        op_elapsed="$(ui_format_elapsed_ms "$op_start_ms")"
        echo ""
        ui_log_ok "Emergency rescue complete in ${op_elapsed}. System restored to safe baseline."
        exit 0
        ;;

    deep-setup)
        shift || true
        case "${1:-}" in
            "")
                deep_setup "$PLUGIN_ROOT" "$USER_CONFIG_FILE"
                exit $?
                ;;
            --remove)
                deep_setup_remove "$USER_CONFIG_FILE"
                exit $?
                ;;
            *)
                ui_log_fail "Unknown option '$1' for 'deep-setup'." "Usage: $CMD_NAME deep-setup [--remove]"
                exit 1
                ;;
        esac
        ;;

    deep-shell)
        shift || true
        deep_shell_cmd "$PLUGIN_ROOT" "$USER_CONFIG_FILE" "$@"
        exit $?
        ;;

    __deep-enter-worker)
        deep_enter_worker "$CONFIG_FILE" "$REAL_SCRIPT"
        exit $?
        ;;

    __deep-post-boot)
        # Called by the post-boot hook when Hyprland starts while deep state exists
        # (root backup timer or a manual login after DEEP_DEGRADED): finish the exit.
        if deep_state_exists; then
            case "$(deep_state_get state "")" in
                DEEP_SERVER|DEEP_DEGRADED)
                    deep_lock_held && exit 0
                    deep_exit_transaction "$CONFIG_FILE" "false"
                    exit $?
                    ;;
            esac
        fi
        exit 0
        ;;

    version|--version|-v)
        printf "oma-server v%s\n" "$OMA_SERVER_VERSION"
        exit 0
        ;;

    help|--help|-h|"")
        print_usage
        if [[ -z "$cmd" ]]; then
            exit 1
        fi
        exit 0
        ;;

    *)
        ui_log_fail "Unrecognized command '$cmd'." "Run '$CMD_NAME --help' for usage details."
        print_usage
        exit 1
        ;;
esac
