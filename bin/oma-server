#!/usr/bin/env bash
# ~/.config/omarchy/plugins/server-mode/bin/omarchy-server-mode
# Core CLI coordinator for oma-server (Omarchy Server-Mode)
set -euo pipefail

# 1. Startup pre-flight dependency audit
for dep in jq hyprctl flock date pgrep; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        echo "Error: Required system tool '$dep' was not found in PATH." >&2
        exit 1
    fi
done

# 2. Directory and module path resolution
CMD_NAME="$(basename "$0")"
REAL_SCRIPT="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$REAL_SCRIPT")" &>/dev/null && pwd)"
PLUGIN_ROOT="$(cd -- "$SCRIPT_DIR/.." &>/dev/null && pwd)"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/server-mode/config.toml"
LIB_DIR="$PLUGIN_ROOT/lib"

if [[ ! -f "$LIB_DIR/snapshot.sh" ]]; then
    echo "Error: Required library '$LIB_DIR/snapshot.sh' not found." >&2
    exit 1
fi
if [[ ! -f "$LIB_DIR/transition.sh" ]]; then
    echo "Error: Required library '$LIB_DIR/transition.sh' not found." >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$LIB_DIR/snapshot.sh"
# shellcheck source=/dev/null
source "$LIB_DIR/transition.sh"

# 3. User & Session Scoping (Strictly inside ephemeral /run/user/${UID})
RUN_DIR="/run/user/${UID}/omarchy-server-mode"
SNAPSHOT_FILE="$RUN_DIR/active-snapshot.json"
LOCK_FILE="$RUN_DIR/lock"

# 4. Helper: Extract whitelist entries from config.toml
get_whitelist_services() {
    if [[ -f "$CONFIG_FILE" ]]; then
        sed -n '/^\[whitelist\]/,/^\[/p' "$CONFIG_FILE" \
            | grep -oE '"[^"]+"' \
            | tr -d '"' || true
    else
        cat <<EOF
docker.service
containerd.service
podman.service
tailscaled.service
syncthing.service
caddy.service
nginx.service
sshd.service
pipewire.service
wireplumber.service
EOF
    fi
}

# 5. Helper: Render transition diff plan table
print_diff_table() {
    local snapshot_json="$1"
    local timeout_val="${2:-}"

    local cur_anim cur_blur cur_shadow cur_vfr cur_dpms
    cur_anim=$(echo "$snapshot_json" | jq -r '.compositor_properties["animations:enabled"]')
    cur_blur=$(echo "$snapshot_json" | jq -r '.compositor_properties["decoration:blur:enabled"]')
    cur_shadow=$(echo "$snapshot_json" | jq -r '.compositor_properties["decoration:drop_shadow"]')
    cur_vfr=$(echo "$snapshot_json" | jq -r '.compositor_properties["misc:vfr"]')
    cur_dpms=$(echo "$snapshot_json" | jq -r '.compositor_properties.dpms_status')

    local qs_pid qs_running qs_action
    qs_pid=$(echo "$snapshot_json" | jq -r '.quickshell_state.pid')
    qs_running=$(echo "$snapshot_json" | jq -r '.quickshell_state.was_running')
    qs_action=$(echo "$snapshot_json" | jq -r '.quickshell_state.action_taken')

    local qs_desc
    if [[ "$qs_running" == "true" ]]; then
        qs_desc="Running (PID: $qs_pid)"
    else
        qs_desc="Not Running"
    fi

    local timeout_desc="None (Manual toggle)"
    if [[ -n "$timeout_val" && "$timeout_val" != "0" ]]; then
        timeout_desc="$timeout_val (Auto-restore)"
    fi

    echo ""
    echo "================================================================================"
    echo " OMA-SERVER: PROPOSED TRANSITION PLAN (HOST -> HOMELAB)"
    echo "================================================================================"
    printf "%-30s | %-20s | %-22s\n" "PROPERTY / SUBSYSTEM" "CURRENT VALUE" "PROPOSED HOMELAB VALUE"
    echo "-------------------------------+----------------------+-------------------------"
    printf "%-30s | %-20s | %-22s\n" "animations:enabled" "$cur_anim" "0 (Disabled)"
    printf "%-30s | %-20s | %-22s\n" "decoration:blur:enabled" "$cur_blur" "false (Disabled)"
    printf "%-30s | %-20s | %-22s\n" "decoration:drop_shadow" "$cur_shadow" "false (Disabled)"
    printf "%-30s | %-20s | %-22s\n" "misc:vfr" "$cur_vfr" "1 (Enforced)"
    printf "%-30s | %-20s | %-22s\n" "display:dpms" "$( [[ "$cur_dpms" == "true" ]] && echo "ON" || echo "OFF" )" "OFF (Panel Powerdown)"
    printf "%-30s | %-20s | %-22s\n" "omarchy-shell (Quickshell)" "$qs_desc" "${qs_action} (Suspended)"
    printf "%-30s | %-20s | %-22s\n" "systemd-logind inhibitor" "Inactive" "Active (Lid/Sleep Block)"
    printf "%-30s | %-20s | %-22s\n" "dead man's switch timer" "None" "$timeout_desc"
    echo "================================================================================"
    echo "TIER-0 PROTECTED HOMELAB SERVICES AUDIT:"

    while IFS= read -r svc; do
        [[ -z "$svc" ]] && continue
        local status="inactive"

        # Check systemd system scope
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            status="active (system)"
        # Check systemd user scope
        elif systemctl --user is-active --quiet "$svc" 2>/dev/null; then
            status="active (user)"
        fi

        if [[ "$status" != "inactive" ]]; then
            printf "  [PROTECTED] %-25s -> %s\n" "$svc" "$status"
        else
            printf "  [UNTOUCHED] %-25s -> inactive (will remain untouched)\n" "$svc"
        fi
    done < <(get_whitelist_services)
    echo "================================================================================"
}

# 6. CLI Command Parser
cmd="${1:-}"

case "$cmd" in
    status)
        # Check for presence of lock and valid snapshot in /run/user/${UID}/
        if [[ -f "$LOCK_FILE" && -f "$SNAPSHOT_FILE" ]]; then
            if validate_snapshot "$SNAPSHOT_FILE" >/dev/null 2>&1; then
                local ts date_str in_status in_pid
                ts=$(jq -r '.timestamp' "$SNAPSHOT_FILE" 2>/dev/null || echo "0")
                date_str=$(date -d "@$ts" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "epoch:$ts")

                if [[ -f "$RUN_DIR/inhibitor.pid" ]]; then
                    in_pid=$(cat "$RUN_DIR/inhibitor.pid" 2>/dev/null || true)
                    if [[ -n "$in_pid" ]] && kill -0 "$in_pid" 2>/dev/null; then
                        in_status="Active (PID: $in_pid)"
                    else
                        in_status="Stale"
                    fi
                else
                    in_status="Inactive"
                fi

                echo "[MODE] HOMELAB_MODE (Active since $date_str)"
                echo "  • Power Inhibitor: $in_status"
                echo "  • Runtime State:   $RUN_DIR"
                if [[ -f "$RUN_DIR/timeout.pid" ]]; then
                    echo "  • Timeout Guard:   Active (PID: $(cat "$RUN_DIR/timeout.pid" 2>/dev/null || true))"
                fi
                exit 0
            fi
        fi
        echo "[MODE] HOST_LAPTOP (Default desktop profile active)"
        exit 0
        ;;

    diff)
        # In-memory execution: ZERO disk writes or system mutations
        snapshot_in_memory=$(capture_snapshot "sigstop")
        print_diff_table "$snapshot_in_memory" ""
        exit 0
        ;;

    enable)
        is_dry_run=false
        timeout_arg=""
        shift || true

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --dry-run)
                    is_dry_run=true
                    shift
                    ;;
                --timeout)
                    timeout_arg="$2"
                    shift 2
                    ;;
                *)
                    echo "Error: Unknown option '$1' for enable command." >&2
                    exit 1
                    ;;
            esac
        done

        # If already in homelab mode, notify user
        if [[ -f "$LOCK_FILE" && -f "$SNAPSHOT_FILE" ]] && validate_snapshot "$SNAPSHOT_FILE" >/dev/null 2>&1; then
            echo "System is already in HOMELAB_MODE. Use '$CMD_NAME disable' to restore desktop mode."
            exit 0
        fi

        # In-memory snapshot generation
        snapshot_in_memory=$(capture_snapshot "sigstop")

        if [[ "$is_dry_run" == true ]]; then
            print_diff_table "$snapshot_in_memory" "$timeout_arg"
            echo ""
            echo "[DRY-RUN COMPLETE] No changes were made to the system."
            exit 0
        fi

        # Interactive confirmation path
        print_diff_table "$snapshot_in_memory" "$timeout_arg"
        echo ""
        read -r -p "Ready to apply Homelab Mode. Proceed? [y/N] " confirm
        if [[ "${confirm,,}" != "y" ]]; then
            echo "Operation cancelled by user. No modifications were made."
            exit 0
        fi

        # Create session runtime directory (tmpfs, user-only permissions)
        mkdir -p "$RUN_DIR"
        chmod 700 "$RUN_DIR"

        # Acquire exclusive lock
        exec 200>"$LOCK_FILE"
        if ! flock -n 200; then
            echo "Error: Another process currently holds the lock at '$LOCK_FILE'." >&2
            exit 1
        fi

        # Write atomic snapshot to tmpfs
        echo "$snapshot_in_memory" > "$SNAPSHOT_FILE"
        chmod 600 "$SNAPSHOT_FILE"

        # Validate written artifact
        if ! validate_snapshot "$SNAPSHOT_FILE"; then
            echo "Error: Snapshot validation failed after write. Removing invalid artifact." >&2
            rm -f "$SNAPSHOT_FILE"
            exit 1
        fi

        # Phase 2: Apply mutations and inhibitors
        apply_homelab_mode "$RUN_DIR" "$CONFIG_FILE" "$SNAPSHOT_FILE" "$timeout_arg" "$REAL_SCRIPT"

        echo ""
        echo "[OK] System successfully transitioned to HOMELAB_MODE."
        echo "Tip: Run '$CMD_NAME disable' or touch physical mouse/keyboard to wake."
        exit 0
        ;;

    disable)
        shift || true
        is_auto_timeout=false
        if [[ "${1:-}" == "--auto-timeout" ]]; then
            is_auto_timeout=true
        fi

        if [[ ! -f "$SNAPSHOT_FILE" ]]; then
            echo "Notice: System is already in HOST_LAPTOP mode (no active snapshot found)."
            exit 0
        fi

        if [[ "$is_auto_timeout" == true ]]; then
            echo "==> [AUTO-TIMEOUT] Dead man's switch timer expired. Restoring desktop profile..."
        else
            echo "==> Initiating restoration to HOST_LAPTOP mode..."
        fi

        # Phase 3: Restore host desktop state
        restore_host_mode "$RUN_DIR" "$SNAPSHOT_FILE"

        # Release lock file
        rm -f "$LOCK_FILE"

        echo ""
        echo "[OK] Desktop successfully restored to HOST_LAPTOP mode."
        exit 0
        ;;

    rescue)
        echo "==> Triggering Emergency Rescue Recovery..."
        force_rescue_mode "$RUN_DIR" "$SNAPSHOT_FILE"
        echo ""
        echo "[OK] Emergency rescue complete. System restored to safe baseline."
        exit 0
        ;;

    *)
        echo "Usage: $CMD_NAME <command> [options]"
        echo ""
        echo "Commands:"
        echo "  status                   Report current mode (HOST vs HOMELAB) and active inhibitors"
        echo "  diff                     Show in-memory diff between current host state and homelab mode"
        echo "  enable [--dry-run]       Transition to Homelab Mode (--dry-run for simulation)"
        echo "         [--timeout <val>] Optional auto-revert timer (e.g. 2h, 45m)"
        echo "  disable                  Restore full Host/Laptop desktop session and release locks"
        echo "  rescue                   Emergency fallback to unfreeze shell, wake screen, and reset"
        exit 1
        ;;
esac
